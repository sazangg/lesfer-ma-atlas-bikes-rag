    {
      "id": "e1",
      "type": "heading",
      "level": 2,
      "text": "2 Warranty term"
    },
    {
      "id": "e2",
      "type": "paragraph",
      "text": "K-1 batteries purchased on or after 1 June 2025 carry a warranty of 1 year from the purchase date."
    },
    {
      "id": "e3",
      "type": "heading",
      "level": 2,
      "text": "3 Exclusions"
    },
    {
      "id": "e4",
      "type": "paragraph",
      "text": "Damage caused by leaving the battery fully discharged for more than three months is not covered."
    }
  ]
}
