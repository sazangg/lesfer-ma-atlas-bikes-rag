      "level": 2,
      "text": "6 Battery safety checks before delivery"
    },
    {
      "id": "e7",
      "page": 13,
      "type": "paragraph",
      "text": "Scope: K-1, 24 V battery pack, frame-mounted, standard charger."
    },
    {
      "id": "e8",
      "page": 13,
      "type": "table",
      "header": [
        "ID",
        "Check"
      ],
      "rows": [
        [
          "R01",
          "Check that the battery serial number matches the delivery note."
        ],
        [
          "R02",
          "Inspect the battery casing for cracks or dents."
        ],
        [
          "R03",
          "Check that the charging port cover closes fully."
        ],
        [
          "R04",
          "Charge the battery to at least 50 percent before delivery."
        ],
        [
          "R05",
          "Check that the speed limiter is set to 15 km/h."
        ],
        [
          "R06",
          "Check that the parental lock code has been set with the buyer."
        ]
      ]
    },
    {
