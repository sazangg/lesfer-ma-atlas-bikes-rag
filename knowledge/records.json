      "source": "ERR-C3-R2#4.71",
      "access": "staff",
      "code": "E-471",
      "component": "battery",
      "product": "C-3",
      "text": "E-471 (C-3): the battery is too cold to charge. Bring the bike indoors and wait until the battery warms to room temperature before charging. Charging below 0 degrees Celsius is blocked to protect the cells."
    },
