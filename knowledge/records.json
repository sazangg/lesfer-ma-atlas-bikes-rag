    {
      "id": "ERR-C3-R2-4.17-record",
      "type": "error_code",
      "source": "ERR-C3-R2#4.17",
      "access": "staff",
      "code": "E-417",
      "component": "battery",
      "product": "C-3",
      "text": "E-417 (C-3): the battery is too hot to charge. Unplug the charger and let the battery cool to room temperature before charging again. If it happens on every charge, test the battery's temperature sensor."
    },
    {
      "id": "ERR-C3-R2-4.18-record",
      "type": "error_code",
      "source": "ERR-C3-R2#4.18",
      "access": "staff",
      "code": "E-418",
      "component": "motor",
      "product": "C-3",
      "text": "E-418 (C-3): the motor drew too much current and assistance was switched off. Stop, switch the bike off for ten seconds, and restart. Reduce the assistance level on steep climbs with heavy loads."
    },
    {
      "id": "ERR-C3-R2-4.71-record",
